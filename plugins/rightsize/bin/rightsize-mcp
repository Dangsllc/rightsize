#!/bin/sh
# Start the Rightsize MCP server (stdio) from a Rightsize checkout: RIGHTSIZE_ROOT if set, else the
# repository this plugin sits in (when loaded with --plugin-dir), else ~/rightsize.
# Nothing may be printed to stdout before the server starts: stdout is the MCP channel.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
for cand in "${RIGHTSIZE_ROOT:-}" "$here/../.." "$HOME/rightsize"; do
  if [ -n "$cand" ] && [ -d "$cand/configs/suites" ]; then
    root=$(cd "$cand" && pwd)
    if ! command -v uv >/dev/null 2>&1; then
      echo "rightsize: uv is not installed; run /rightsize:setup" >&2
      exit 1
    fi
    exec uv run --quiet --directory "$root" rightsize mcp
  fi
done
echo "rightsize: no Rightsize checkout found; set RIGHTSIZE_ROOT or run /rightsize:setup" >&2
exit 1
